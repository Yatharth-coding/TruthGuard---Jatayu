# ===========================================
# TruthGuard Environment Configuration
# ===========================================
# Copy this file to .env and fill in values

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/truthguard

# --- JWT ---
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_EXPIRES_IN=7d

# --- CORS ---
CLIENT_URL=http://localhost:5173

# --- AI Provider ---
# Options: gemini, openai, mock
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Demo Mode ---
# When true, uses deterministic mock AI responses and shows DEMO label in UI
DEMO_MODE=true

# --- File Upload ---
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=uploads

# --- Rate Limiting ---
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
