{
  "name": "truthguard",
  "version": "1.0.0",
  "description": "TruthGuard — Adversarial Verification for Multi-Agent Document Q&A",
  "private": true,
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "start": "cd server && npm start",
    "build": "cd client && npm run build",
    "test": "cd server && npm test",
    "test:unit": "cd server && npm run test:unit",
    "test:integration": "cd server && npm run test:integration",
    "test:e2e": "cd server && npm run test:e2e",
    "test:live": "cd server && npm run test:live",
    "lint": "cd client && npm run lint"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
